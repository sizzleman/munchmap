# munchmap needs no secrets to run.
# Optional overrides:
# MUNCHMAP_DATA=./data                      # or an https URL to a data.json bundle
# MUNCHMAP_HOME=~/.munchmap                 # where your local profile is stored
# MUNCHMAP_OVERPASS_URL=https://overpass-api.de/api/interpreter
# MUNCHMAP_REPO=sizzleman/munchmap          # where deal submissions are filed
